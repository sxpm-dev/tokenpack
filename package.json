{
  "name": "codeart-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.3.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "yarn workspaces foreach -A --exclude codeart-monorepo run lint",
    "lint:fix": "yarn workspaces foreach -A --exclude codeart-monorepo run lint:fix",
    "format": "yarn workspaces foreach -A --exclude codeart-monorepo run format",
    "test": "yarn workspace tokenpack test",
    "test:watch": "yarn workspace tokenpack test:watch",
    "tokenpack": "yarn workspace tokenpack tokenpack",
    "benchmark:generate": "yarn workspace tokenpack benchmark:generate",
    "benchmark:run": "yarn workspace tokenpack benchmark:run",
    "app": "yarn workspace tokenpack-app dev",
    "app:build": "yarn workspace tokenpack-app build",
    "start": "yarn workspace tokenpack-app start"
  }
}
