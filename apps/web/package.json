{
  "name": "tokenpack-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3003",
    "build": "next build",
    "start": "next start --port 3003",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src",
    "bench-app:modules": "tsx bench-app/scripts/generate-modules.ts",
    "bench-app:css": "tsx bench-app/scripts/generate-css.ts",
    "bench-app:images": "tsx bench-app/scripts/generate-assets.ts",
    "bench-app:lazy": "tsx bench-app/scripts/generate-lazy.ts",
    "bench-app:bundle": "tsx bench-app/scripts/bundle-single.ts",
    "bench-app:router": "tsx bench-app/scripts/encode-router.ts",
    "bench-app:html": "tsx bench-app/scripts/build-html-shells.ts",
    "bench-app:bootloader": "tsx bench-app/scripts/build-bootloader.ts",
    "bench-app:entry-dynamic": "tsx bench-app/scripts/build-entry-dynamic.ts",
    "bench-app:entry-single": "tsx bench-app/scripts/build-entry-single.ts",
    "bench-app:native-html": "tsx bench-app/scripts/build-native-html.ts",
    "bench-app:compress": "tsx bench-app/scripts/compress-assets.ts",
    "bench-app:build:size": "yarn bench-app:modules && yarn bench-app:css && yarn bench-app:images && yarn bench-app:lazy && yarn bench-app:bundle && yarn bench-app:router && yarn bench-app:html && yarn bench-app:bootloader && yarn bench-app:entry-dynamic && yarn bench-app:entry-single && yarn bench-app:native-html",
    "bench-app:build": "BENCH_SIZE=small yarn bench-app:build:size && BENCH_SIZE=medium yarn bench-app:build:size && BENCH_SIZE=large yarn bench-app:build:size && yarn bench-app:compress",
    "bench-app:shells:size": "yarn bench-app:html && yarn bench-app:bootloader && yarn bench-app:entry-dynamic && yarn bench-app:entry-single && yarn bench-app:native-html",
    "bench-app:shells": "BENCH_SIZE=small yarn bench-app:shells:size && BENCH_SIZE=medium yarn bench-app:shells:size && BENCH_SIZE=large yarn bench-app:shells:size && yarn bench-app:compress",
    "bench-app:serve": "tsx bench-app/scripts/serve.ts",
    "bench-app:bench": "tsx bench-app/scripts/bench.ts",
    "bench-app:upload": "tsx bench-app/scripts/upload-aws.ts",
    "benchmark": "yarn benchmark:generate && yarn benchmark:run && yarn benchmark:run:extended && yarn benchmark:provenance && yarn benchmark:runtime && yarn benchmark:apply-diff && yarn benchmark:json-playground && yarn generate:fixtures && yarn bench-app:build && yarn benchmark:audit --prune",
    "benchmark:generate": "tsx scripts/benchmark/generate.ts",
    "benchmark:run": "tsx scripts/benchmark/run.ts",
    "benchmark:run:extended": "tsx scripts/benchmark/run-extended.ts",
    "benchmark:runtime": "tsx scripts/generate-runtime-fixtures.ts",
    "benchmark:apply-diff": "tsx scripts/generate-apply-diff-fixtures.ts",
    "benchmark:apply-diff:case": "tsx scripts/generate-apply-diff-fixtures.ts --strategy=five-bundles --size=1000 --updated=1",
    "benchmark:json-playground": "tsx scripts/generate-json-playground-fixtures.ts",
    "runtime:fixtures": "yarn benchmark:runtime",
    "generate:fixtures": "tsx scripts/generate-scenario-fixtures.ts",
    "benchmark:provenance": "tsx scripts/benchmark/record-provenance.ts",
    "benchmark:audit": "node scripts/audit-fixtures.mjs",
    "benchmark:verify-playgrounds": "node scripts/verify-playgrounds.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@heroui/react": "^3.0.3",
    "@heroui/styles": "^3.0.3",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "^4.1.5",
    "@tokenpack/browser": "workspace:*",
    "@tokenpack/node": "workspace:*",
    "adm-zip": "^0.5.16",
    "next": "^15.3.1",
    "next-themes": "^0.4.0",
    "nextra": "^4.2.17",
    "pngjs": "^7.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-is": "^19.2.5",
    "react-markdown": "^9.0.1",
    "recharts": "^3.8.1",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "roughjs": "^4.6.6",
    "sharp": "^0.34.5",
    "shiki": "^3.0.0",
    "tailwind-variants": "^0.3.0",
    "tailwindcss": "^4.1.5",
    "tinybench": "^2.9.0",
    "tokenpack": "workspace:*"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^20.17.50",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.3",
    "@types/react-is": "^19",
    "@types/three": "^0.169.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.0",
    "playwright": "^1.48.0",
    "prettier": "^3.8.3",
    "three": "^0.169.0",
    "tokenpack-eslint-config": "workspace:*",
    "tsx": "^4.19.1",
    "typescript": "^5.8.3"
  }
}
