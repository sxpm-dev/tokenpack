diff --git a/packages/core/tests/streaming-png-performance.test.ts b/packages/core/tests/streaming-png-performance.test.ts
new file mode 100644
index 00000000..9296307a
--- /dev/null
+++ b/packages/core/tests/streaming-png-performance.test.ts
@@ -0,0 +1,77 @@
+import { encode } from '@tokenpack/node'
+import { expect, it, vi } from 'vitest'
+
+import { decodeStreamingPng } from '../src/surfaces/streaming-png-decoder'
+
+function source(bytes: Uint8Array, chunkSize: number) {
+  let offset = 0
+
+  return new ReadableStream<Uint8Array>({
+    pull(controller) {
+      if (offset === bytes.length) return controller.close()
+      controller.enqueue(bytes.subarray(offset, offset + chunkSize))
+      offset = Math.min(bytes.length, offset + chunkSize)
+    },
+  })
+}
+
+it('delivers fragmented PNG rows without timer polling', async () => {
+  const png = await encode(Buffer.from('fragmented streaming '.repeat(1000)), {
+    algo: 'linear-stream-deflate',
+  })
+  const timer = vi.spyOn(globalThis, 'setTimeout')
+
+  try {
+    const handle = await decodeStreamingPng(source(png, 13))
+    const rows = []
+
+    for await (const row of handle.rows) rows.push(row)
+    expect(rows).toHaveLength(handle.height)
+    expect(rows.every(row => row.length === handle.width * handle.fileChannels)).toBe(true)
+    expect(timer).not.toHaveBeenCalled()
+  } finally {
+    timer.mockRestore()
+  }
+})
+
+it('rejects a truncated PNG rather than returning partial success', async () => {
+  const png = await encode(Buffer.from('truncated'), { algo: 'linear-stream-deflate' })
+  const handle = await decodeStreamingPng(source(png.subarray(0, png.length - 12), 17))
+
+  await expect(
+    (async () => {
+      for await (const row of handle.rows) void row
+    })(),
+  ).rejects.toThrow(/truncated|IEND/)
+})
+
+it('propagates a transport error after the header without hanging', async () => {
+  const png = await encode(Buffer.from('transport error'), { algo: 'linear-stream-deflate' })
+  let controller!: ReadableStreamDefaultController<Uint8Array>
+  const input = new ReadableStream<Uint8Array>({
+    start(c) {
+      controller = c
+      c.enqueue(png.subarray(0, 33))
+    },
+  })
+  const handle = await decodeStreamingPng(input)
+  const pending = (async () => {
+    for await (const row of handle.rows) void row
+  })()
+
+  controller.error(new Error('transport failed'))
+  await expect(pending).rejects.toThrow('transport failed')
+})
+
+it('drains rows produced while a slow consumer yields', async () => {
+  const { randomBytes } = await import('node:crypto')
+  const png = await encode(randomBytes(100000), { algo: 'linear-stream-deflate' })
+  const handle = await decodeStreamingPng(source(png, 257))
+  let count = 0
+
+  for await (const row of handle.rows) {
+    expect(row.length).toBe(handle.width * handle.fileChannels)
+    if (count++ === 0) await new Promise(resolve => setTimeout(resolve, 20))
+  }
+  expect(count).toBe(handle.height)
+})
diff --git a/packages/node/tests/decode-performance.test.ts b/packages/node/tests/decode-performance.test.ts
new file mode 100644
index 00000000..1caf695b
--- /dev/null
+++ b/packages/node/tests/decode-performance.test.ts
@@ -0,0 +1,66 @@
+import { expect, it, vi } from 'vitest'
+
+import { decode, encode } from '../src'
+import { PngSurface } from '../src/surfaces/png'
+
+it('reuses pixels from detection instead of decoding the PNG twice', async () => {
+  const source = Buffer.from('surface reuse '.repeat(1000))
+  const token = await encode(source, { algo: 'linear-deflate' })
+  const read = vi.spyOn(PngSurface.prototype, 'readBuffer')
+
+  try {
+    const pack = await decode(token)
+
+    if (pack.isPack() || pack.isDiff()) throw new Error('expected file')
+    expect(Buffer.from(await pack.content())).toEqual(source)
+    expect(read).toHaveBeenCalledTimes(1)
+  } finally {
+    read.mockRestore()
+  }
+})
+
+it('shares routed file decoding across single, array and stream access and retries failures', async () => {
+  const { mkdtemp, writeFile, rm } = await import('node:fs/promises')
+  const { tmpdir } = await import('node:os')
+  const { join } = await import('node:path')
+  const { decodeRouter, TokenPack } = await import('../src')
+  const { DeflateCompressor } = await import('../src/compressors/deflate-compressor')
+  const dir = await mkdtemp(join(tmpdir(), 'tokenpack-router-reuse-'))
+  const text = 'repeated routed data '.repeat(1000)
+  const artifacts = await encode(
+    new TokenPack()
+      .withFile('file.txt', text)
+      .router({ chunkLayout: 'source-order', fileCompressor: 'deflate-6' }),
+  )
+  let spy: ReturnType<typeof vi.spyOn> | undefined
+
+  try {
+    for (const artifact of artifacts)
+      await writeFile(
+        join(dir, artifact.filename),
+        new Uint8Array(await artifact.blob.arrayBuffer()),
+      )
+    const pack = await decodeRouter(join(dir, 'router.png'))
+
+    if (!pack.isRouter()) throw new Error('expected router')
+    expect(await pack.text('file.txt')).toBe(text)
+    spy = vi.spyOn(DeflateCompressor.prototype, 'decompress')
+    const [array, streamed] = await Promise.all([
+      pack.text(['file.txt']),
+      pack.stream.text(['file.txt']),
+    ])
+
+    expect([...array.values()]).toEqual([text])
+    expect([...streamed.values()]).toEqual([text])
+    expect(spy).not.toHaveBeenCalled()
+    const retry = await decodeRouter(join(dir, 'router.png'))
+
+    if (!retry.isRouter()) throw new Error('expected router')
+    spy.mockRejectedValueOnce(new Error('transient decode failure'))
+    await expect(retry.text('file.txt')).rejects.toThrow('transient decode failure')
+    expect(await retry.text('file.txt')).toBe(text)
+  } finally {
+    spy?.mockRestore()
+    await rm(dir, { recursive: true, force: true })
+  }
+})
