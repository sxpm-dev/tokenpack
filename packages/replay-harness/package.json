{
  "name": "tokenpack-replay-harness",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Playwright-driven harness that benchmarks page load with TokenPack interception against a baseline, on any target URL.",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "baseline": "tsx bin/baseline.ts",
    "record:raw": "tsx bin/record.ts",
    "record": "tsx bin/record.ts 'https://valeriis-my-site-261.editor.wix.com/edit/od/c3eee97d-b623-4f0f-80b2-a22eaf7fff3b?metaSiteId=d10191ef-d39a-432d-a235-4d8a9d1e7df8&http_referrer=odeditor.new&debug=all' --capture-grace-ms=30000 --min-group-size=0 --bundle-chunks=20",
    "encode:bundle": "tsx bin/encode-bundle.ts 'https://valeriis-my-site-261.editor.wix.com/edit/od/c3eee97d-b623-4f0f-80b2-a22eaf7fff3b?metaSiteId=d10191ef-d39a-432d-a235-4d8a9d1e7df8&http_referrer=odeditor.new&debug=all' --min-group-size=0 --bundle-chunks=20",
    "encode:bundle:single": "tsx bin/encode-bundle.ts 'https://valeriis-my-site-261.editor.wix.com/edit/od/c3eee97d-b623-4f0f-80b2-a22eaf7fff3b?metaSiteId=d10191ef-d39a-432d-a235-4d8a9d1e7df8&http_referrer=odeditor.new&debug=all' --min-group-size=0",
    "replay": "tsx bin/replay.ts",
    "encode": "tsx bin/encode.ts",
    "upload": "tsx bin/upload.ts",
    "benchmark": "tsx bin/benchmark.ts 'https://valeriis-my-site-261.editor.wix.com/edit/od/c3eee97d-b623-4f0f-80b2-a22eaf7fff3b?metaSiteId=d10191ef-d39a-432d-a235-4d8a9d1e7df8&http_referrer=odeditor.new&debug=all' NONE 10 --local --captured-app --isolate --token-debug",
    "benchmark:sw": "tsx bin/benchmark.ts 'https://valeriis-my-site-261.editor.wix.com/edit/od/c3eee97d-b623-4f0f-80b2-a22eaf7fff3b?metaSiteId=d10191ef-d39a-432d-a235-4d8a9d1e7df8&http_referrer=odeditor.new&debug=all' NONE 10 --local --captured-app --isolate --token-debug --sw",
    "benchmark:sw:service:3": "tsx bin/benchmark.ts 'https://valeriis-my-site-261.editor.wix.com/edit/od/c3eee97d-b623-4f0f-80b2-a22eaf7fff3b?metaSiteId=d10191ef-d39a-432d-a235-4d8a9d1e7df8&http_referrer=odeditor.new&debug=all' NONE 3 --local --captured-app --isolate --token-debug --sw",
    "benchmark:sw:service:10": "tsx bin/benchmark.ts 'https://valeriis-my-site-261.editor.wix.com/edit/od/c3eee97d-b623-4f0f-80b2-a22eaf7fff3b?metaSiteId=d10191ef-d39a-432d-a235-4d8a9d1e7df8&http_referrer=odeditor.new&debug=all' NONE 10 --local --captured-app --isolate --token-debug --sw",
    "benchmark:sw:bundle": "tsx bin/benchmark.ts 'https://valeriis-my-site-261.editor.wix.com/edit/od/c3eee97d-b623-4f0f-80b2-a22eaf7fff3b?metaSiteId=d10191ef-d39a-432d-a235-4d8a9d1e7df8&http_referrer=odeditor.new&debug=all' NONE 10 --local --captured-app --isolate --token-debug --sw --bundle-chunks=20",
    "benchmark:sw:bundle20:3": "tsx bin/benchmark.ts 'https://valeriis-my-site-261.editor.wix.com/edit/od/c3eee97d-b623-4f0f-80b2-a22eaf7fff3b?metaSiteId=d10191ef-d39a-432d-a235-4d8a9d1e7df8&http_referrer=odeditor.new&debug=all' NONE 3 --local --captured-app --isolate --token-debug --sw --bundle-chunks=20",
    "benchmark:sw:bundle20:10": "tsx bin/benchmark.ts 'https://valeriis-my-site-261.editor.wix.com/edit/od/c3eee97d-b623-4f0f-80b2-a22eaf7fff3b?metaSiteId=d10191ef-d39a-432d-a235-4d8a9d1e7df8&http_referrer=odeditor.new&debug=all' NONE 10 --local --captured-app --isolate --token-debug --sw --bundle-chunks=20",
    "benchmark:sw:bundle:single": "tsx bin/benchmark.ts 'https://valeriis-my-site-261.editor.wix.com/edit/od/c3eee97d-b623-4f0f-80b2-a22eaf7fff3b?metaSiteId=d10191ef-d39a-432d-a235-4d8a9d1e7df8&http_referrer=odeditor.new&debug=all' NONE 10 --local --captured-app --isolate --token-debug --sw --bundle",
    "benchmark:sw:bundle-single:3": "tsx bin/benchmark.ts 'https://valeriis-my-site-261.editor.wix.com/edit/od/c3eee97d-b623-4f0f-80b2-a22eaf7fff3b?metaSiteId=d10191ef-d39a-432d-a235-4d8a9d1e7df8&http_referrer=odeditor.new&debug=all' NONE 3 --local --captured-app --isolate --token-debug --sw --bundle",
    "benchmark:sw:bundle-single:10": "tsx bin/benchmark.ts 'https://valeriis-my-site-261.editor.wix.com/edit/od/c3eee97d-b623-4f0f-80b2-a22eaf7fff3b?metaSiteId=d10191ef-d39a-432d-a235-4d8a9d1e7df8&http_referrer=odeditor.new&debug=all' NONE 10 --local --captured-app --isolate --token-debug --sw --bundle",
    "benchmark:sw:sweep:3": "tsx bin/benchmark-sweep.ts sw:sweep:3",
    "login": "tsx bin/login.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@tokenpack/browser": "workspace:*",
    "@tokenpack/node": "workspace:*",
    "esbuild": "^0.24.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "playwright": "^1.48.0",
    "tokenpack": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "eslint": "^9.39.0",
    "tokenpack-eslint-config": "workspace:*",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
