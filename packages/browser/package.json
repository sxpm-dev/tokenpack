{
  "name": "@tokenpack/browser",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Browser/DOM/React adapters for TokenPack on top of @tokenpack/core",
  "license": "MIT",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./hooks": "./src/hooks/index.ts"
  },
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "test": "vitest run",
    "build:browser": "tsup src/index.ts --format esm --platform browser --target es2022 --external react --external react-dom --out-dir dist --dts",
    "verify:browser": "node scripts/verify-browser-build.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "tokenpack": "workspace:*",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.3",
    "eslint": "^9.39.0",
    "prettier": "^3.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tokenpack-eslint-config": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  }
}
