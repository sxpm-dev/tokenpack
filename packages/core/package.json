    "test": "vitest run",
    "test:watch": "vitest",
    "tokenpack": "tsx src/cli.ts"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "commander": "^14.0.3",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.2"
