{
  "name": "tokenpack",
  "version": "1.0.0",
  "type": "module",
  "description": "Encode source files into images and decode them back",
  "license": "MIT",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./stream-decoder": "./src/stream-decoder.ts",
    "./types": "./src/types.ts",
    "./token/base": "./src/token/base.ts",
    "./header": "./src/header.ts",
    "./archive": "./src/archive.ts",
    "./pack/types": "./src/pack/types.ts",
    "./pack/from-bytes": "./src/pack/from-bytes.ts",
    "./pack-format/encode-pack": "./src/pack-format/encode-pack.ts",
    "./pack-format/decode-pack": "./src/pack-format/decode-pack.ts",
    "./pack-format/encode-file": "./src/pack-format/encode-file.ts",
    "./pack-format/decompress": "./src/pack-format/decompress.ts",
    "./pack-format/encode-diff": "./src/pack-format/encode-diff.ts",
    "./pack-format/apply-diff": "./src/pack-format/apply-diff.ts",
    "./pack-format/manifest": "./src/pack-format/manifest.ts",
    "./diff": "./src/diff.ts",
    "./diff-pack": "./src/diff-pack.ts",
    "./components/options": "./src/components/options.ts",
    "./algorithms/catalog": "./src/algorithms/catalog.ts",
    "./algorithms/catalog-info": "./src/algorithms/catalog-info.ts",
    "./algorithms/types": "./src/algorithms/types.ts",
    "./algorithms/pixel-algorithm": "./src/algorithms/pixel-algorithm.ts",
    "./algorithms/pixel-range-algorithm": "./src/algorithms/pixel-range-algorithm.ts",
    "./codecs": "./src/codecs/index.ts",
    "./codecs/linear": "./src/codecs/linear/index.ts",
    "./codecs/types": "./src/codecs/types.ts",
    "./codecs/zstdpix-metadata": "./src/codecs/zstdpix-metadata.ts",
    "./compressors": "./src/compressors/index.ts",
    "./compressors/types": "./src/compressors/types.ts",
    "./compressors/registry": "./src/compressors/registry.ts",
    "./fec": "./src/fec/index.ts",
    "./drawers": "./src/drawers/index.ts",
    "./surfaces": "./src/surfaces/index.ts",
    "./surfaces/types": "./src/surfaces/types.ts",
    "./surfaces/registry": "./src/surfaces/registry.ts",
    "./surfaces/channels": "./src/surfaces/channels.ts",
    "./surfaces/streaming-png-decoder": "./src/surfaces/streaming-png-decoder.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --platform node --target es2022 --out-dir dist --dts",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write src tests",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@tokenpack/node": "workspace:*",
    "@types/node": "^25.6.0",
    "eslint": "^9.39.0",
    "prettier": "^3.8.3",
    "tokenpack-eslint-config": "workspace:*",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  }
}
