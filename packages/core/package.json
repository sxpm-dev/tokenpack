  "devDependencies": {
    "@types/adm-zip": "^0",
    "@types/node": "^25.6.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.39.0",
    "prettier": "^3.8.3",
    "tokenpack-eslint-config": "workspace:*",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  }
