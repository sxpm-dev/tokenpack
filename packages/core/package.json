    "./header": "./src/header.ts",
    "./style": "./src/style.ts",
    "./crypto": "./src/crypto.ts",
    "./archive": "./src/archive.ts",
    "./diff": "./src/diff.ts",
    "./diff-pack": "./src/diff-pack.ts",
    "./presets": "./src/presets.ts",
    "./algorithms": "./src/algorithms/index.ts",
    "./algorithms/registry": "./src/algorithms/registry.ts",
    "./algorithms/catalog": "./src/algorithms/catalog.ts",
    "./algorithms/catalog-info": "./src/algorithms/catalog-info.ts",
    "./algorithms/register-all": "./src/algorithms/register-all.ts",
    "./algorithms/types": "./src/algorithms/types.ts",
    "./codecs": "./src/codecs/index.ts",
    "./codecs/types": "./src/codecs/types.ts",
    "./codecs/metadata": "./src/codecs/metadata.ts",
    "./compressors": "./src/compressors/index.ts",
    "./compressors/types": "./src/compressors/types.ts",
    "./compressors/modes": "./src/compressors/modes.ts",
    "./compressors/registry": "./src/compressors/registry.ts",
    "./fec": "./src/fec/index.ts",
    "./fec/types": "./src/fec/types.ts",
    "./fec/registry": "./src/fec/registry.ts",
    "./fec/modes": "./src/fec/modes.ts",
    "./drawers": "./src/drawers/index.ts",
    "./drawers/types": "./src/drawers/types.ts",
    "./surfaces": "./src/surfaces/index.ts",
    "./surfaces/types": "./src/surfaces/types.ts",
    "./surfaces/info": "./src/surfaces/info.ts",
    "./surfaces/registry": "./src/surfaces/registry.ts",
    "./surfaces/channels": "./src/surfaces/channels.ts",
    "./surfaces/png": "./src/surfaces/png-surface.ts",
    "./surfaces/streaming-png": "./src/surfaces/streaming-png-surface.ts",
    "./surfaces/webp": "./src/surfaces/webp-surface.ts",
    "./surfaces/avif": "./src/surfaces/avif-surface.ts"
