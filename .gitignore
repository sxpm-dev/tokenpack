.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Swap the comments on the following lines if you wish to use zero-installs
# In that case, don't forget to run `yarn config set enableGlobalCache false`!
# Documentation here: https://yarnpkg.com/features/caching#zero-installs

#!.yarn/cache
.pnp.*
node_modules
**/.next
**/dist
**/tsconfig.tsbuildinfo

# macOS turds
**/.DS_Store

# Local experimental codec scratch (not part of the build)
archived-codecs/

# Personal scratch notes
TODO.md
IDEAS.md

# Benchmark fixtures (re-generatable via `yarn benchmark`)
packages/app/benchmark-fixtures/

# Legacy generated fixture locations
benchmark/tokens/
packages/app/runtime-fixtures/
packages/app/runtime-bench-fixtures/

# encode-times.json is an intermediate (consumed only by run-extended.ts, not the dashboard)
packages/app/benchmark-results/encode-times.json

# results.json, results-extended.json, archive-times.json under
# packages/app/benchmark-results/ ARE committed so they ship to Vercel.
# To reset: delete and re-run `yarn benchmark:run`.
